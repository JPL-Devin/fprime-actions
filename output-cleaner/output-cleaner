#!/usr/bin/env bash
# Filter transient terminal output from piped build logs.
#
# Reads stdin and writes stdout, emulating what a smart terminal would leave
# visible: segments overwritten via carriage returns are dropped (only the
# final segment of each line is kept), and transient status lines (e.g. ninja
# "[N/M] target" or make "[ N%]" progress) are collapsed so only the last one
# is printed at end of stream. When workflow debug mode is enabled
# (RUNNER_DEBUG=1), all output is passed through unmodified.
#
# Usage:
#     fprime-util build ... 2>&1 | output-cleaner
#
# Use `set -o pipefail` (or `shell: bash` in GitHub Actions, which implies it)
# so the pipeline preserves the build's exit status.

if [ "${RUNNER_DEBUG:-0}" = "1" ]; then
    exec cat
fi

exec awk '
{
    # A carriage return overwrites everything before it; keep the final
    # non-empty segment, as a terminal would display.
    n = split($0, seg, "\r")
    line = ""
    for (i = n; i >= 1; i--) {
        if (seg[i] != "") { line = seg[i]; break }
    }
    # Transient progress lines: hold the latest and only print it at EOF.
    if (line ~ /^\[[0-9]+\/[0-9]+\]/ || line ~ /^\[ *[0-9]+%\]/) {
        pending = line
        has_pending = 1
        next
    }
    print line
}
END {
    if (has_pending) print pending
}
'
